{
  "name": "lets-intern-client",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "local": "node scripts/local.mjs",
    "dev:web": "turbo run dev --filter=@letscareer/web",
    "dev:admin": "turbo run dev --filter=@letscareer/admin",
    "dev:mentor": "turbo run dev --filter=@letscareer/mentor",
    "dev:mock": "NEXT_PUBLIC_API_MOCKING=enabled VITE_API_MOCKING=enabled turbo run dev:local --filter=@letscareer/web --filter=@letscareer/mentor",
    "dev:mock:web": "NEXT_PUBLIC_API_MOCKING=enabled turbo run dev:local --filter=@letscareer/web",
    "dev:mock:mentor": "VITE_API_MOCKING=enabled turbo run dev:local --filter=@letscareer/mentor",
    "prod": "turbo run dev:prod --filter=@letscareer/web --filter=@letscareer/admin --filter=@letscareer/mentor",
    "prod:web": "turbo run dev:prod --filter=@letscareer/web",
    "prod:admin": "turbo run dev:prod --filter=@letscareer/admin",
    "prod:mentor": "turbo run dev:prod --filter=@letscareer/mentor",
    "prod:build": "turbo run build:prod --filter=@letscareer/web",
    "prod:start": "turbo run start:prod --filter=@letscareer/web",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@letscareer/web",
    "build:admin": "turbo run build --filter=@letscareer/admin",
    "build:mentor": "turbo run build --filter=@letscareer/mentor",
    "lint": "turbo run lint",
    "lint:web": "turbo run lint --filter=@letscareer/web",
    "lint:admin": "turbo run lint --filter=@letscareer/admin",
    "lint:mentor": "turbo run lint --filter=@letscareer/mentor",
    "format": "oxfmt apps/web apps/admin apps/mentor",
    "format:check": "oxfmt --check apps/web apps/admin apps/mentor",
    "format:web": "oxfmt apps/web",
    "format:admin": "oxfmt apps/admin",
    "format:mentor": "oxfmt apps/mentor",
    "check": "pnpm check:gitignore && pnpm format:check && pnpm lint",
    "check:gitignore": "node scripts/check-gitignore-tracked.mjs",
    "check:web": "oxfmt --check apps/web && pnpm lint:web",
    "check:admin": "oxfmt --check apps/admin && pnpm lint:admin",
    "check:mentor": "oxfmt --check apps/mentor && pnpm lint:mentor",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "turbo run typecheck --filter=@letscareer/web",
    "typecheck:admin": "turbo run typecheck --filter=@letscareer/admin",
    "typecheck:mentor": "turbo run typecheck --filter=@letscareer/mentor",
    "test": "turbo run test",
    "test:web": "turbo run test --filter=@letscareer/web",
    "test:admin": "turbo run test --filter=@letscareer/admin",
    "test:mentor": "turbo run test --filter=@letscareer/mentor",
    "e2e": "turbo run e2e --filter=@letscareer/web",
    "e2e:web": "turbo run e2e --filter=@letscareer/web",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.3.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "protobufjs@<7.5.5": "^7.5.5",
      "path-to-regexp@<6.3.0": "6.3.0",
      "undici@6": "^6.24.0",
      "websocket-driver@<0.7.5": "^0.7.5",
      "dompurify@<3.4.17": "^3.4.17"
    }
  }
}
